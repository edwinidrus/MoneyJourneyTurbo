{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "question": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git rebase*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "sudo*": "deny",
      "docker*": "deny",
      "systemctl*": "deny",
      "hermes*": "deny",
      "ollama*": "deny",
      "crontab*": "deny"
    },
    "skill": {
      "*": "deny",
      "dragonhoard-*": "allow",
      "test-driven-development": "allow",
      "systematic-debugging": "allow",
      "verification-before-completion": "allow",
      "receiving-code-review": "allow"
    },
    "task": {
      "*": "deny",
      "dragonhoard-*": "allow"
    }
  },
  "mcp": {
    "exa": {
      "type": "local",
      "command": [
        "true"
      ],
      "enabled": false
    }
  },
  "model": "opencode/deepseek-v4.1-flash-free"
}
